# Firebase Admin SDK
FIREBASE_CREDENTIALS_PATH=firebase-adminsdk.json
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# AI Services
OPENAI_API_KEY=
NANO_BANANA_API_KEY=
GEMINI_API_KEY=
FAL_API_KEY=

# Video Generation (Google Veo)
VEO_MODEL=google/veo-3.1-generate-001

# Telegram Bot
TELEGRAM_BOT_TOKEN=
FRONTEND_URL=http://localhost:3000

# Ngrok / Webhook URL (only needed for legacy Replicate integration; not required for Veo)
BACKEND_URL=https://your-backend-domain.run.app

# Deployment
ALLOWED_ORIGINS=https://your-frontend-domain.web.app
CORS_ORIGIN_REGEX=
